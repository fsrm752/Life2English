# ---- Python 缓存与构建产物 ----
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
build/
dist/
.venv/
venv/
env/

# ---- 密钥 / 环境变量 / 敏感资料（禁止入库）----
.env
*.env
.env.*
*.key
*.pem
*.p12
secrets*
credentials*
token*.local

# ---- 编辑器 / IDE ----
.vscode/
.idea/
*.swp
*.swo

# ---- 系统文件 ----
.DS_Store
Thumbs.db
desktop.ini

# ---- 日志与临时文件 ----
*.log
*.tmp
*.bak
